diff --git a/neo4j/internal/connector/flowsteward_dialer_test.go b/neo4j/internal/connector/flowsteward_dialer_test.go
new file mode 100644
--- /dev/null
+++ b/neo4j/internal/connector/flowsteward_dialer_test.go
@@ -0,0 +1,9 @@
+package connector
+import("testing";"context";"net";"errors";"crypto/tls";"github.com/neo4j/neo4j-go-driver/v6/neo4j/config")
+func TestFlowStewardSocketDialer(t *testing.T){
+ sentinel:=errors.New("dial denied");called:=false
+ c:=Connector{Network:"tcp",Config:&config.Config{SocketDialer:func(ctx context.Context,network,address string)(net.Conn,error){called=true;if network!="tcp"||address!="db.example:7687" {t.Fatal(network,address)};return nil,sentinel}}}
+ _,err:=c.createConnection(context.Background(),"db.example:7687");if !called||!errors.Is(err,sentinel){t.Fatal("dial hook was bypassed",err)}
+ c.Config.TlsConfig=&tls.Config{MinVersion:tls.VersionTLS12}
+ tc:=c.tlsConfig("db.example");if tc.ServerName!="db.example"||tc.InsecureSkipVerify||tc.MinVersion<tls.VersionTLS12{t.Fatal("verified TLS hostname lost")}
+}
diff --git a/neo4j/internal/bolt/flowsteward_limit_test.go b/neo4j/internal/bolt/flowsteward_limit_test.go
new file mode 100644
--- /dev/null
+++ b/neo4j/internal/bolt/flowsteward_limit_test.go
@@ -0,0 +1,12 @@
+package bolt
+import("testing";"context";"bytes";"encoding/binary";"strings")
+func TestFlowStewardMessageLimit(t *testing.T){
+ var wire bytes.Buffer
+ header:=make([]byte,2);binary.BigEndian.PutUint16(header,65535)
+ for i:=0;i<33;i++{wire.Write(header);wire.Write(make([]byte,65535))};wire.Write([]byte{0,0})
+ buffer,_,err:=dechunkMessage(context.Background(),&wire,nil,-1)
+ if err==nil||!strings.Contains(err.Error(),"2 MiB limit"){t.Fatal("oversized wire message accepted",err)}
+ if cap(buffer)>2*1024*1024+4096{t.Fatal("buffer grew beyond cap",cap(buffer))}
+ small:=bytes.NewBuffer([]byte{0,1,42,0,0});_,message,err:=dechunkMessage(context.Background(),small,nil,-1)
+ if err!=nil||len(message)!=1||message[0]!=42{t.Fatal("small message rejected",err)}
+}

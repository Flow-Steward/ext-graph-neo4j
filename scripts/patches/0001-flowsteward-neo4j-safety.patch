@@ -0,0 +1,144 @@
+package neo4j
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	driver "github.com/neo4j/neo4j-go-driver/v6/neo4j"
+)
+
+type flowStewardDriver struct {
+	driver.Driver
+	t       *testing.T
+	session *flowStewardSession
+	config  driver.SessionConfig
+}
+
+func (d *flowStewardDriver) ExecuteQueryBookmarkManager() driver.BookmarkManager {
+	d.t.Fatal("retrying eager ExecuteQuery call path used")
+	return nil
+}
+func (d *flowStewardDriver) NewSession(ctx context.Context, c driver.SessionConfig) driver.Session {
+	d.config = c
+	if deadline, ok := ctx.Deadline(); !ok || time.Until(deadline) > 30*time.Second {
+		d.t.Fatal("query deadline missing")
+	}
+	return d.session
+}
+
+type flowStewardSession struct {
+	driver.Session
+	t      *testing.T
+	tx     *flowStewardTransaction
+	closed bool
+}
+
+func (s *flowStewardSession) BeginTransaction(_ context.Context, configurers ...func(*driver.TransactionConfig)) (driver.ExplicitTransaction, error) {
+	c := driver.TransactionConfig{}
+	for _, f := range configurers {
+		f(&c)
+	}
+	if c.Timeout != 25*time.Second {
+		s.t.Fatal("transaction timeout missing")
+	}
+	return s.tx, nil
+}
+func (s *flowStewardSession) Close(ctx context.Context) error {
+	s.closed = true
+	if ctx.Err() != nil {
+		s.t.Fatal("cancelled cleanup context")
+	}
+	return nil
+}
+
+type flowStewardTransaction struct {
+	driver.ExplicitTransaction
+	t                 *testing.T
+	result            *flowStewardResult
+	calls             int
+	committed, closed bool
+	statement         string
+	params            map[string]any
+}
+
+func (tx *flowStewardTransaction) Run(_ context.Context, statement string, params map[string]any) (driver.Result, error) {
+	tx.calls++
+	tx.statement, tx.params = statement, params
+	return tx.result, nil
+}
+func (tx *flowStewardTransaction) Commit(context.Context) error { tx.committed = true; return nil }
+func (tx *flowStewardTransaction) Close(ctx context.Context) error {
+	tx.closed = true
+	if ctx.Err() != nil {
+		tx.t.Fatal("cancelled rollback context")
+	}
+	return nil
+}
+
+type flowStewardResult struct {
+	driver.Result
+	rows     []*driver.Record
+	at       int
+	err      error
+	consumed bool
+}
+
+func (r *flowStewardResult) Next(context.Context) bool {
+	if r.at >= len(r.rows) {
+		return false
+	}
+	r.at++
+	return true
+}
+func (r *flowStewardResult) Record() *driver.Record { return r.rows[r.at-1] }
+func (r *flowStewardResult) Err() error             { return r.err }
+func (r *flowStewardResult) Consume(context.Context) (driver.ResultSummary, error) {
+	r.consumed = true
+	return nil, nil
+}
+
+func TestFlowStewardRunQueryCallPath(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		count     int
+		value     any
+		err       error
+		wantError bool
+	}{{"bounded", 100, int64(9223372036854775807), nil, false}, {"row overflow", 101, "x", nil, true}, {"byte overflow", 1, strings.Repeat("x", 480*1024), nil, true}, {"cursor error", 1, "x", errors.New("read failed"), true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			result := &flowStewardResult{err: tc.err}
+			for i := 0; i < tc.count; i++ {
+				result.rows = append(result.rows, &driver.Record{Keys: []string{"value"}, Values: []any{tc.value}})
+			}
+			tx := &flowStewardTransaction{t: t, result: result}
+			session := &flowStewardSession{t: t, tx: tx}
+			d := &flowStewardDriver{t: t, session: session}
+			source := &Source{Config: Config{Database: "safe"}, Driver: d}
+			out, err := source.RunQuery(context.Background(), "RETURN $bound AS value", map[string]any{"bound": int64(42)}, true, false)
+			if (err != nil) != tc.wantError {
+				t.Fatalf("unexpected result: %v", err)
+			}
+			if tx.calls != 1 || !tx.closed || !session.closed || tx.committed == tc.wantError {
+				t.Fatalf("unsafe transaction lifecycle: %#v", tx)
+			}
+			if d.config.FetchSize != 32 || d.config.AccessMode != driver.AccessModeRead || d.config.DatabaseName != "safe" {
+				t.Fatalf("session controls lost: %#v", d.config)
+			}
+			if tx.statement != "RETURN $bound AS value" || tx.params["bound"] != int64(42) {
+				t.Fatal("parameter binding changed")
+			}
+			if !tc.wantError {
+				if !result.consumed {
+					t.Fatal("result not consumed")
+				}
+				rows := out.([]map[string]any)
+				if rows[0]["value"].(map[string]any)["$integer"] != "9223372036854775807" {
+					t.Fatal("integer precision lost")
+				}
+			}
+		})
+	}
+}

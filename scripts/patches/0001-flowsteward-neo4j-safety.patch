new file mode 100644
--- /dev/null
+++ b/internal/tools/neo4j/neo4jcypher/flowsteward_parameters.go
@@ -0,0 +1,20 @@
+package neo4jcypher
+import("encoding/json";"fmt";"io";"math";"strings")
+func flowStewardStaticParameters(raw string)(map[string]any,error){
+ decoder:=json.NewDecoder(strings.NewReader(raw));decoder.UseNumber()
+ var value map[string]any
+ if err:=decoder.Decode(&value);err!=nil||value==nil{return nil,fmt.Errorf("staticParameters must be a JSON object")}
+ var extra any
+ if err:=decoder.Decode(&extra);err!=io.EOF{return nil,fmt.Errorf("staticParameters must contain one JSON object")}
+ normalized,err:=flowStewardNumberTypes(value);if err!=nil{return nil,err};return normalized.(map[string]any),nil
+}
+func flowStewardNumberTypes(value any)(any,error){
+ switch v:=value.(type){
+ case json.Number:
+ if !strings.ContainsAny(string(v),".eE"){number,err:=v.Int64();if err!=nil{return nil,fmt.Errorf("integer parameter outside signed 64-bit range")};return number,nil}
+ number,err:=v.Float64();if err!=nil||math.IsNaN(number)||math.IsInf(number,0){return nil,fmt.Errorf("invalid floating point parameter")};return number,nil
+ case map[string]any:for key,item:=range v{converted,err:=flowStewardNumberTypes(item);if err!=nil{return nil,err};v[key]=converted};return v,nil
+ case []any:for i,item:=range v{converted,err:=flowStewardNumberTypes(item);if err!=nil{return nil,err};v[i]=converted};return v,nil
+ default:return value,nil
+ }
+}

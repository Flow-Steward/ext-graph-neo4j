+package neo4jcypher
+
+import (
+	"context"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/goccy/go-yaml"
+	"github.com/googleapis/mcp-toolbox/internal/sources"
+	"github.com/googleapis/mcp-toolbox/internal/tools"
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+)
+
+type flowStewardCaptureSource struct {
+	statement        string
+	params           map[string]any
+	readOnly, dryRun bool
+}
+
+func (*flowStewardCaptureSource) SourceType() string             { return "neo4j" }
+func (*flowStewardCaptureSource) ToConfig() sources.SourceConfig { return nil }
+func (*flowStewardCaptureSource) IsReadOnly() bool               { return false }
+func (*flowStewardCaptureSource) Neo4jDatabase() string          { return "neo4j" }
+func (s *flowStewardCaptureSource) RunQuery(_ context.Context, statement string, params map[string]any, readOnly, dryRun bool) (any, error) {
+	s.statement, s.params, s.readOnly, s.dryRun = statement, params, readOnly, dryRun
+	return "ok", nil
+}
+
+func flowStewardDecodedTool(t *testing.T, extra string) (tools.Tool, error) {
+	t.Helper()
+	cfg, err := newConfig(context.Background(), "safe", yaml.NewDecoder(strings.NewReader("type: neo4j-cypher\nsource: db\ndescription: bound query\nstatement: RETURN $integer AS value\n"+extra)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cfg.Initialize(context.Background())
+}
+
+func TestFlowStewardToolCallPath(t *testing.T) {
+	tool, err := flowStewardDecodedTool(t, "readOnly: true\nstaticParameters: '{\"integer\":9223372036854775807,\"float\":1.0}'\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	source := &flowStewardCaptureSource{}
+	if err := tool.ValidateSource(source); err != nil {
+		t.Fatal(err)
+	}
+	_, invokeErr := tool.Invoke(context.Background(), source, parameters.ParamValues{{Name: "integer", Value: "caller value"}}, "")
+	if invokeErr != nil {
+		t.Fatal(invokeErr)
+	}
+	if !source.readOnly || source.dryRun || source.statement != "RETURN $integer AS value" {
+		t.Fatalf("safety flags lost on Invoke: %#v", source)
+	}
+	if want := map[string]any{"integer": int64(9223372036854775807), "float": float64(1)}; !reflect.DeepEqual(source.params, want) {
+		t.Fatalf("static binding lost: %#v", source.params)
+	}
+	if a := tool.GetAnnotations(source); a.ReadOnlyHint == nil || !*a.ReadOnlyHint {
+		t.Fatal("read-only annotation lost")
+	}
+}
+func TestFlowStewardToolInitializationPolicy(t *testing.T) {
+	for _, extra := range []string{"staticParameters: 'null'\n", "staticParameters: '{\"x\":9223372036854775808}'\n", "staticParameters: '{}'\nparameters:\n  - name: x\n    type: string\n    description: x\n"} {
+		if _, err := flowStewardDecodedTool(t, extra); err == nil {
+			t.Fatalf("unsafe configuration accepted: %s", extra)
+		}
+	}
+	tool, err := flowStewardDecodedTool(t, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := tool.GetAnnotations(&flowStewardCaptureSource{})
+	if a.ReadOnlyHint == nil || *a.ReadOnlyHint || a.DestructiveHint == nil || !*a.DestructiveHint {
+		t.Fatal("write-capable tool incorrectly labeled read-only")
+	}
+}
diff --git a/internal/tools/neo4j/neo4jcypher/flowsteward_parameters.go b/internal/tools/neo4j/neo4jcypher/flowsteward_parameters.go
new file mode 100644
index 0000000000..398ccf1c30
--- /dev/null
+++ b/internal/tools/neo4j/neo4jcypher/flowsteward_parameters.go
@@ -0,0 +1,64 @@
+package neo4jcypher
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"strings"
+)
+
+func flowStewardStaticParameters(raw string) (map[string]any, error) {
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+	var value map[string]any
+	if err := decoder.Decode(&value); err != nil || value == nil {
+		return nil, fmt.Errorf("staticParameters must be a JSON object")
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, fmt.Errorf("staticParameters must contain one JSON object")
+	}
+	normalized, err := flowStewardNumberTypes(value)
+	if err != nil {
+		return nil, err
+	}
+	return normalized.(map[string]any), nil
+}
+func flowStewardNumberTypes(value any) (any, error) {
+	switch v := value.(type) {
+	case json.Number:
+		if !strings.ContainsAny(string(v), ".eE") {
+			number, err := v.Int64()
+			if err != nil {
+				return nil, fmt.Errorf("integer parameter outside signed 64-bit range")
+			}
+			return number, nil
+		}
+		number, err := v.Float64()
+		if err != nil || math.IsNaN(number) || math.IsInf(number, 0) {
+			return nil, fmt.Errorf("invalid floating point parameter")
+		}
+		return number, nil
+	case map[string]any:
+		for key, item := range v {
+			converted, err := flowStewardNumberTypes(item)
+			if err != nil {
+				return nil, err
+			}
+			v[key] = converted
+		}
+		return v, nil
+	case []any:
+		for i, item := range v {
+			converted, err := flowStewardNumberTypes(item)
+			if err != nil {
+				return nil, err
+			}
+			v[i] = converted
+		}
+		return v, nil
+	default:
+		return value, nil
+	}
+}

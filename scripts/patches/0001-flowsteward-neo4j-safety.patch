index 0000000000..5359718158
--- /dev/null
+++ b/internal/sources/neo4j/flowsteward_policy.go
@@ -0,0 +1,127 @@
+package neo4j
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"time"
+)
+
+func flowStewardURI(raw string) (bool, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Hostname() == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || (u.Path != "" && u.Path != "/") {
+		return false, fmt.Errorf("invalid direct Bolt URI")
+	}
+	if u.Scheme != "bolt" && u.Scheme != "bolt+s" {
+		return false, fmt.Errorf("only bolt and bolt+s are supported")
+	}
+	return u.Scheme == "bolt+s", nil
+}
+func flowStewardValue(value any) any {
+	switch v := value.(type) {
+	case int64:
+		if v > 9007199254740991 || v < -9007199254740991 {
+			return map[string]any{"$integer": strconv.FormatInt(v, 10)}
+		}
+		return v
+	case []any:
+		for i := range v {
+			v[i] = flowStewardValue(v[i])
+		}
+		return v
+	case map[string]any:
+		for k, x := range v {
+			v[k] = flowStewardValue(x)
+		}
+		return v
+	default:
+		return value
+	}
+}
+func flowStewardAppend(rows *[]map[string]any, total *int, row map[string]any) error {
+	if len(*rows) >= 100 {
+		return fmt.Errorf("Neo4j response exceeds result row limit")
+	}
+	encoded, err := json.Marshal(row)
+	if err != nil {
+		return fmt.Errorf("Neo4j response is not JSON serializable")
+	}
+	size := len(encoded)
+	if len(*rows) > 0 {
+		size++
+	}
+	if *total+size > 480*1024 {
+		return fmt.Errorf("Neo4j response exceeds result byte limit")
+	}
+	*total += size
+	*rows = append(*rows, row)
+	return nil
+}
+
+var flowStewardReserved = []string{
+	"0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4",
+	"::/128", "::1/128", "64:ff9b::/96", "64:ff9b:1::/48", "100::/64", "2001::/23", "2001:db8::/32", "2002::/16", "3fff::/20", "fc00::/7", "fe80::/10", "ff00::/8",
+}
+
+func flowStewardAddressAllowed(raw string, tls, allowPrivate bool) error {
+	ip, err := netip.ParseAddr(raw)
+	if err != nil {
+		return fmt.Errorf("invalid destination address")
+	}
+	ip = ip.Unmap()
+	private := !ip.IsGlobalUnicast() || ip.IsPrivate()
+	for _, value := range flowStewardReserved {
+		if netip.MustParsePrefix(value).Contains(ip) {
+			private = true
+			break
+		}
+	}
+	// IPv6 public unicast currently lives in 2000::/3; reject other special ranges.
+	if ip.Is6() && !netip.MustParsePrefix("2000::/3").Contains(ip) {
+		private = true
+	}
+	if private && !allowPrivate {
+		return fmt.Errorf("destination is not a public address")
+	}
+	if !private && !tls {
+		return fmt.Errorf("TLS is required for public destinations")
+	}
+	return nil
+}
+
+type flowStewardDialer struct{ tls, allowPrivate bool }
+
+func (d flowStewardDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, fmt.Errorf("invalid destination")
+	}
+	addresses, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, fmt.Errorf("destination lookup failed")
+	}
+	if len(addresses) == 0 {
+		return nil, fmt.Errorf("destination has no addresses")
+	}
+	for _, a := range addresses {
+		if a.Zone != "" {
+			return nil, fmt.Errorf("scoped destination is forbidden")
+		}
+		if err = flowStewardAddressAllowed(a.IP.String(), d.tls, d.allowPrivate); err != nil {
+			return nil, err
+		}
+	}
+	dialer := net.Dialer{Timeout: 10 * time.Second, KeepAlive: 30 * time.Second}
+	for _, a := range addresses {
+		connection, e := dialer.DialContext(ctx, network, net.JoinHostPort(a.IP.String(), port))
+		if e == nil {
+			return connection, nil
+		}
+		err = e
+	}
+	return nil, fmt.Errorf("destination connection failed: %w", err)
+}

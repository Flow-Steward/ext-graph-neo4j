+package neo4j
+import("testing";"encoding/json";"strings";"context";"time";"net";"fmt")
+func TestFlowStewardPolicy(t *testing.T){
+ for _, tc:=range []struct{ip string; tls,private,want bool}{{"8.8.8.8",true,false,true},{"8.8.8.8",false,true,false},{"127.0.0.1",true,false,false},{"127.0.0.1",false,true,true},{"::ffff:127.0.0.1",true,false,false},{"169.254.169.254",true,false,false},{"100.64.0.1",true,false,false},{"2001:db8::1",true,false,false},{"2606:4700:4700::1111",true,false,true}} {if got:=flowStewardAddressAllowed(tc.ip,tc.tls,tc.private)==nil;got!=tc.want {t.Fatalf("%s: %v",tc.ip,got)}}
+ for _,uri:=range []string{"neo4j+s://example.com","bolt+ssc://example.com","bolt+unix:///tmp/socket","bolt+s://user:secret@example.com","bolt+s://example.com?x=y"} {if _,err:=flowStewardURI(uri);err==nil{t.Fatal(uri)}}
+ for _,uri:=range []string{"bolt+s://example.com:7687","bolt://localhost:7687"} {if _,err:=flowStewardURI(uri);err!=nil{t.Fatal(err)}}
+}
+func TestFlowStewardResults(t *testing.T){
+ encoded,err:=json.Marshal(flowStewardValue(map[string]any{"large":int64(9223372036854775807),"small":int64(23),"nested":[]any{int64(-9223372036854775807)}}));if err!=nil{t.Fatal(err)}
+ if !strings.Contains(string(encoded),`"$integer":"9223372036854775807"`)||!strings.Contains(string(encoded),`"small":23`){t.Fatal(string(encoded))}
+ rows:=make([]map[string]any,0);total:=2
+ for i:=0;i<100;i++ {if err:=flowStewardAppend(&rows,&total,map[string]any{"i":i});err!=nil{t.Fatal(err)}}
+ if err:=flowStewardAppend(&rows,&total,map[string]any{});err==nil{t.Fatal("row overflow accepted")}
+ rows=rows[:0];total=2
+ if err:=flowStewardAppend(&rows,&total,map[string]any{"huge":strings.Repeat("x",480*1024)});err==nil{t.Fatal("byte overflow accepted")}
+}
+func TestFlowStewardDialPolicyBeforeConnect(t *testing.T){
+ listener,err:=net.Listen("tcp","127.0.0.1:0");if err!=nil{t.Fatal(err)};defer listener.Close()
+ ctx,cancel:=context.WithTimeout(context.Background(),time.Second);defer cancel()
+ d:=flowStewardDialer{tls:true}
+ if conn,err:=d.DialContext(ctx,"tcp",listener.Addr().String());err==nil {conn.Close();t.Fatal("private destination accepted")}
+ d.allowPrivate=true
+ conn,err:=d.DialContext(ctx,"tcp",listener.Addr().String());if err!=nil{t.Fatal(fmt.Sprint(err))};conn.Close()
+}

+package neo4jcypher
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestFlowStewardStaticNumberKinds(t *testing.T) {
+	got, err := flowStewardStaticParameters(`{"integer":1,"float":1.0,"exponent":1e0,"nested":{"value":-9223372036854775808},"vector":[0.1,0.2],"null":null}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{"integer": int64(1), "float": float64(1), "exponent": float64(1), "nested": map[string]any{"value": int64(-9223372036854775808)}, "vector": []any{0.1, 0.2}, "null": nil}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v", got)
+	}
+}
+func TestFlowStewardRejectMalformedStatic(t *testing.T) {
+	for _, raw := range []string{`null`, `[]`, `{"x":`, `{"x":1} {}`, `{"x":9223372036854775808}`, `{"x":1e9999}`, `{"x":NaN}`} {
+		if _, err := flowStewardStaticParameters(raw); err == nil {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+}
